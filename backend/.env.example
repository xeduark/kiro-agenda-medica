# Backend environment variables (sample values only — no real secrets).
# Copy to .env and fill in your local values:  cp .env.example .env

# PostgreSQL connection string (local development).
DATABASE_URL=postgres://agenda:agenda@localhost:5432/agenda

# HTTP port the Express server listens on.
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Allowed origin for CORS (the frontend dev server).
CORS_ORIGIN=http://localhost:5173

# --- AWS (only needed for appointment reminders via SQS; optional in local) ---
# AWS_REGION=us-east-1
# REMINDERS_QUEUE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
